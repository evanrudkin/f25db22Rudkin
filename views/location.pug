extends layout

block content
  h1 Search Results – Location

  p Below are the locations retrieved from the database.

  .container-fluid
    .row
      ul
        each location in results
          li 
            | #{location.Country} - #{location.primaryLanguage} - Population: #{location.population}

            // Build update path using the ID
            - let destination = `dispatch('/location/update/?id=${location._id}')`

            button.btn.btn-primary.ml-2(onclick=destination) Update

  // JS dispatcher (used by Update button)
  script.
    function dispatch(path){
      window.location.href = path
    }



