extends layout

block content
  h1= title

  // --- BUTTON TO CREATE NEW LOCATION ---
  a.btn.btn-success(href="/location/create" style="margin-bottom: 20px;") Create New Location

  if results.length == 0
    p No locations found.
  else
    table.table.table-striped
      thead
        tr
          th Country
          th Primary Language
          th Population
          th Actions
      tbody
        each location in results
          tr
            td #{location.Country}
            td #{location.primaryLanguage}
            td #{location.population}

            td
              // --- DETAIL BUTTON ---
              a.btn.btn-info.btn-sm(
                href=`/location/detail?id=${location._id}`
              ) Details

              // --- UPDATE BUTTON ---
              a.btn.btn-warning.btn-sm(
                href=`/location/update?id=${location._id}`
              ) Update

              // --- DELETE BUTTON ---
              a.btn.btn-danger.btn-sm(
                href=`/location/delete?id=${location._id}`
              ) Delete


