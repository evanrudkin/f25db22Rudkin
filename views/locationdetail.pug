extends layout

block content
  if !toShow
    h2 Invalid ID — No Location Found
  else
    h1.mb-4 Location Details

    div.card.shadow-lg.p-4.mt-3(style="max-width: 550px;")
      h3.mb-4.text-center #{toShow.Country}

      div.mb-2
        strong Country:
        span.ml-2 #{toShow.Country}

      div.mb-2
        strong Primary Language:
        span.ml-2 #{toShow.primaryLanguage}

      div.mb-2
        strong Population:
        span.ml-2 #{toShow.population}

      div.mb-2
        strong ID:
        span.ml-2 #{toShow._id}

      // Action buttons for easier navigation
      div.mt-4.d-flex.justify-content-between
        a.btn.btn-warning(href=`/location/update/?id=${toShow._id}`) Update
        a.btn.btn-danger(href=`/location/delete/?id=${toShow._id}`) Delete
        a.btn.btn-secondary(href='/location') Back
