extends layout

block content
  h1 Location App

  if (!user)
    h3 You are not logged in.
    a.btn.btn-primary(href="/auth/login") Login
    br
    br
    a.btn.btn-secondary(href="/auth/register") Register

  if (user)
    h3 Welcome, #{user.username}!
    br
    a.btn.btn-success(href="/location") Go to Locations
    br
    br
    a.btn.btn-danger(href="/auth/logout") Logout
